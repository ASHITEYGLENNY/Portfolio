---
import '../styles/global.css';

const projects = [
  {
    title: 'This Portfolio',
    description:
      'My personal portfolio website, designed and built from scratch with Astro and deployed from GitHub.',
    tech: ['Astro', 'HTML', 'CSS', 'GitHub'],
    link: 'https://github.com/ASHITEYGLENNY/Portfolio',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Glennette Ashiety | Web Developer</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Pinyon+Script&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
      <header class="nav">
      <a href="#" class="logo">Glennette<span>.</span></a>
      <nav>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </nav>
      <a href="#contact" class="btn btn-primary nav-btn">Hire me</a>
    </header>
        <main class="hero">
      <div class="hero-inner">
        <div class="hero-text">
          <p class="status"><span class="dot"></span> Open to internships & freelance work</p>
          <p class="eyebrow">Hi, I'm</p>
          <h1>Glennette Ashiety</h1>
          <p class="script">Web developer in the making</p>
          <p class="tagline">
            Level 300 IT student at UPSA in Accra, building web projects and
            learning something new with every one.
          </p>
          <div class="buttons">
            <a href="#projects" class="btn btn-primary">See my work</a>
            <a href="#contact" class="btn btn-outline">Hire me</a>
          </div>
        </div>
        <div class="hero-image">
          <img src="/me.jpg" alt="Photo of Glennette Ashiety" />
        </div>
      </div>
    </main>
        <section id="projects" class="projects">
      <h2>Projects</h2>
      <div class="grid">
        {projects.map((project) => (
          <article class="card">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <ul class="tech">
              {project.tech.map((t) => <li>{t}</li>)}
            </ul>
            <a href={project.link} class="card-link">View code →</a>
          </article>
        ))}
      </div>
    </section>
    <section id="contact" class="contact">
      <h2>Let's work together</h2>
      <p>
        Looking for an intern, or need a website built? Send me a message.
      </p>
      <div class="buttons">
        <a href="mailto:YOUR-EMAIL@example.com" class="btn btn-primary">Email me</a>
        <a
          href="https://wa.me/233XXXXXXXXX?text=Hi%2C%20I%20saw%20your%20portfolio"
          class="btn btn-outline"
        >WhatsApp</a>
      </div>
      <p class="socials">
        <a href="https://github.com/ASHITEYGLENNY">GitHub</a>
        <a href="https://www.linkedin.com/in/YOUR-LINKEDIN">LinkedIn</a>
      </p>
    </section>
  </body>
</html>

<style>
  .hero {
    max-width: 720px;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--pink-tint);
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-size: 0.9rem;
  }
  .dot {
    width: 10px;
    height: 10px;
    background: var(--green);
    border-radius: 50%;
  }
  .eyebrow {
    margin: 2rem 0 0;
    color: var(--pink);
    font-weight: 600;
  }
  h1 {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    margin: 0.25rem 0 1rem;
    line-height: 1.1;
  }
  .tagline {
    font-size: 1.2rem;
    max-width: 55ch;
  }
  .buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .btn {
    padding: 0.8rem 1.6rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
  }
  .btn-primary {
    background: var(--pink);
    color: var(--white);
  }
  .btn-outline {
    border: 2px solid var(--pink);
    color: var(--pink);
  }
  .btn:hover {
    background: var(--pink-light);
    border-color: var(--pink-light);
    color: var(--white);
  }
    .projects {
    background: var(--pink-tint);
    padding: 4rem 1.5rem;
  }
  .projects h2,
  .grid {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }
  h2 {
    font-size: 2rem;
    margin-top: 0;
  }
  .grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .card {
    background: var(--white);
    padding: 1.5rem;
    border-radius: 16px;
    border: 2px solid transparent;
  }
  .card:hover {
    border-color: var(--pink-light);
  }
  .card h3 {
    margin-top: 0;
  }
  .tech {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tech li {
    background: var(--yellow);
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .card-link {
    color: var(--pink);
    font-weight: 600;
    text-decoration: none;
  }
    .nav {
    position: fixed;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    width: min(900px, calc(100% - 2rem));
    box-sizing: border-box;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.8rem 0.6rem 1.4rem;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    border-radius: 999px;
    box-shadow: 0 8px 30px rgba(219, 39, 119, 0.15);
  }
  .logo {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--text);
    text-decoration: none;
  }
  .logo span {
    color: var(--pink);
  }
  .nav nav {
    display: flex;
    gap: 1.5rem;
  }
  .nav nav a {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
  }
  .nav nav a:hover {
    color: var(--pink);
  }
  .nav-btn {
    padding: 0.5rem 1.2rem;
  }

  .hero {
    max-width: none;
    margin: 0;
    padding: 8rem 1.5rem 5rem;
    background: linear-gradient(135deg, #ffffff 0%, var(--pink-tint) 40%, #fbcfe8 100%);
  }
  .hero-inner {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 3rem;
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vw, 4.2rem);
  }
  .script {
    font-family: var(--font-script);
    color: var(--pink);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.2;
    margin: 0 0 1rem;
  }
  .hero-image {
    aspect-ratio: 4 / 5;
    border-radius: 200px 200px 24px 24px;
    background: linear-gradient(160deg, var(--pink-light), var(--pink));
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(219, 39, 119, 0.3);
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .btn:hover {
    background: #be185d;
    border-color: #be185d;
  }

  @media (max-width: 800px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .nav nav {
      display: none;
    }
  }
</style>