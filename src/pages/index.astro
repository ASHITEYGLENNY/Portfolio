---
import '../styles/global.css';

const projects = [
  {
    title: 'This Portfolio',
    description:
      'My personal portfolio website, designed and built from scratch with Astro and deployed from GitHub.',
    tech: ['Astro', 'HTML', 'CSS', 'GitHub'],
    link: 'https://github.com/ASHITEYGLENNY/Portfolio',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Portfolio of Glennette Ashiety - Web Developer & IT Student at UPSA in Accra, Ghana."
    />
    <title>Glennette Ashiety | Web Developer</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Pinyon+Script&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Top Navigation Bar -->
    <header class="nav">
      <a href="#" class="logo">Glennette<span>.</span></a>
      <nav>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </nav>
      <a href="#contact" class="btn btn-primary nav-btn">Hire me</a>
    </header>

    <!-- Hero Section -->
    <main class="hero">
      <div class="hero-inner">
        <div class="hero-text">
          <div class="status">
            <span class="dot"></span>
            <span>Open to internships & freelance work</span>
          </div>
          <p class="eyebrow">Hi, I'm</p>
          <h1>Glennette Ashiety</h1>
          <p class="script">Web developer in the making</p>
          <p class="tagline">
            Level 300 IT student at UPSA in Accra, building web projects and
            learning something new with every one.
          </p>
          <div class="buttons">
            <a href="#projects" class="btn btn-primary">See my work</a>
            <a href="#contact" class="btn btn-outline">Hire me</a>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-image">
            <img src="/portfoliopic.jpg" alt="Photo of Glennette Ashiety" />
          </div>
          <!-- Decorative Flower Photos -->
          <img
            src="/flower1.jpg"
            alt="Decorative pink and yellow plumeria flower"
            class="deco flower1"
            loading="eager"
          />
          <img
            src="/flower2.jpg"
            alt="Decorative creamy yellow plumeria flower"
            class="deco flower2"
            loading="eager"
          />
          <img
            src="/flower3.jpg"
            alt="Decorative pastel pink plumeria flower"
            class="deco flower3"
            loading="eager"
          />
          <img
            src="/flower4.jpg"
            alt="Decorative tropical hibiscus flower"
            class="deco flower4"
            loading="eager"
          />
        </div>
      </div>
    </main>

    <!-- Projects Section -->
    <section id="projects" class="projects">
      <div class="projects-inner">
        <div class="section-header">
          <span class="section-eyebrow">Selected Works</span>
          <h2>Projects</h2>
          <p class="section-desc">
            A showcase of the web projects I have built as I continue to host my design and development skills.
          </p>
        </div>
        <div class="grid">
          {projects.map((project) => (
            <article class="card">
              <div class="card-top">
                <span class="card-badge">Featured</span>
                <h3>{project.title}</h3>
              </div>
              <p class="card-desc">{project.description}</p>
              <ul class="tech">
                {project.tech.map((t) => <li>{t}</li>)}
              </ul>
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="card-link"
              >
                <span>View code on GitHub</span>
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact">
      <div class="contact-inner">
        <div class="contact-card">
          <span class="section-eyebrow">Get In Touch</span>
          <h2>Let's work together</h2>
          <p class="contact-desc">
            Looking for a passionate intern or need a responsive website built? Feel free to reach out — I am always eager to collaborate and discuss new opportunities.
          </p>
          <div class="buttons contact-buttons">
            <a href="mailto:YOUR-EMAIL@example.com" class="btn btn-primary contact-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span>Email me</span>
            </a>
            <a
              href="https://wa.me/233XXXXXXXXX?text=Hi%2C%20I%20saw%20your%20portfolio"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline contact-btn"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.24 8.24-1.45 0-2.87-.38-4.12-1.11l-.3-.17-3.12.82.83-3.04-.19-.31a8.2 8.2 0 0 1-1.26-4.43c0-4.54 3.7-8.24 8.24-8.24zm4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.07-.39-2.03-1.25-.75-.67-1.26-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.23.25-.87.85-.87 2.08 0 1.22.89 2.41 1.02 2.58.13.17 1.76 2.68 4.26 3.76.6.26 1.06.41 1.42.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.23-.17-.48-.29z"/>
              </svg>
              <span>WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Dedicated Styled Footer with GitHub & LinkedIn -->
    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-main">
          <div class="footer-brand">
            <a href="#" class="footer-logo">Glennette<span>.</span></a>
            <p class="footer-bio">
              Web developer in the making. Level 300 IT student at UPSA in Accra, Ghana, dedicated to clean code and delightful design.
            </p>
          </div>

          <div class="footer-nav-col">
            <h4 class="footer-title">Navigation</h4>
            <ul class="footer-links">
              <li><a href="#">Home</a></li>
              <li><a href="#projects">Projects</a></li>
              <li><a href="#contact">Contact</a></li>
            </ul>
          </div>

          <div class="footer-social-col">
            <h4 class="footer-title">Connect</h4>
            <div class="footer-social-buttons">
              <a
                href="https://github.com/ASHITEYGLENNY"
                target="_blank"
                rel="noopener noreferrer"
                class="social-btn github"
                aria-label="GitHub Profile"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                  ></path>
                </svg>
                <span>GitHub</span>
              </a>
              <a
                href="https://www.linkedin.com/in/YOUR-LINKEDIN"
                target="_blank"
                rel="noopener noreferrer"
                class="social-btn linkedin"
                aria-label="LinkedIn Profile"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"
                  ></path>
                </svg>
                <span>LinkedIn</span>
              </a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} Glennette Ashiety. All rights reserved.</p>
          <p class="footer-credit">Built with Astro & Vanilla CSS</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* ==========================================================================
     Top Floating Navbar
     ========================================================================== */
  .nav {
    position: fixed;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    width: min(var(--container-max, 1040px), calc(100% - 2rem));
    box-sizing: border-box;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.65rem 1rem 0.65rem 1.6rem;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 999px;
    box-shadow: 0 8px 30px rgba(219, 39, 119, 0.12);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .logo {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .logo span {
    color: var(--pink);
  }

  .nav nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav nav a {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .nav nav a:hover {
    color: var(--pink);
  }

  .nav-btn {
    padding: 0.55rem 1.35rem;
    font-size: 0.9rem;
  }

  /* ==========================================================================
     Shared Button Styles
     ========================================================================== */
  .buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--pink);
    color: var(--white);
    box-shadow: 0 6px 20px rgba(219, 39, 119, 0.28);
    border: 2px solid var(--pink);
  }

  .btn-primary:hover {
    background: var(--pink-hover);
    border-color: var(--pink-hover);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(219, 39, 119, 0.38);
    color: var(--white);
  }

  .btn-outline {
    background: transparent;
    border: 2px solid var(--pink);
    color: var(--pink);
  }

  .btn-outline:hover {
    background: var(--pink);
    color: var(--white);
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(219, 39, 119, 0.25);
  }

  /* ==========================================================================
     Hero Section
     ========================================================================== */
  .hero {
    position: relative;
    padding: 8.5rem 1.5rem 5.5rem;
    background: linear-gradient(145deg, #ffffff 0%, var(--pink-tint) 45%, #fed7e2 100%);
    overflow: hidden;
  }

  .hero-inner {
    max-width: var(--container-max, 1040px);
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 3.5rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: var(--white);
    border: 1px solid var(--pink-border);
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text);
    box-shadow: 0 4px 15px rgba(219, 39, 119, 0.08);
  }

  .dot {
    width: 9px;
    height: 9px;
    background: var(--green);
    border-radius: 50%;
    display: inline-block;
    position: relative;
  }

  .dot::after {
    content: '';
    position: absolute;
    top: -3px;
    left: -3px;
    right: -3px;
    bottom: -3px;
    border-radius: 50%;
    border: 2px solid var(--green);
    opacity: 0.5;
    animation: pulseDot 2s infinite ease-out;
  }

  @keyframes pulseDot {
    0% { transform: scale(0.8); opacity: 0.8; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  .eyebrow {
    margin: 1.75rem 0 0;
    color: var(--pink);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 5.5vw, 4.3rem);
    font-weight: 700;
    margin: 0.35rem 0 0.5rem;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .script {
    font-family: var(--font-script);
    color: var(--pink);
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.2;
    margin: 0 0 1.25rem;
  }

  .tagline {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 52ch;
    margin: 0;
  }

  /* ==========================================================================
     Hero Visual & Flower Photos
     ========================================================================== */
  .hero-visual {
    position: relative;
    max-width: 360px;
    width: 100%;
    margin: 0 auto;
    z-index: 2;
  }

  .hero-image {
    aspect-ratio: 4 / 5;
    border-radius: 190px 190px 28px 28px;
    background: linear-gradient(160deg, var(--pink-light), var(--pink));
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(219, 39, 119, 0.28);
    position: relative;
    z-index: 2;
    border: 4px solid rgba(255, 255, 255, 0.7);
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-visual:hover .hero-image img {
    transform: scale(1.04);
  }

  /* Flower Decor Elements */
  .deco {
    position: absolute;
    pointer-events: none;
    mix-blend-mode: multiply;
    z-index: 3;
    user-select: none;
    will-change: transform;
    filter: drop-shadow(0 10px 18px rgba(219, 39, 119, 0.2));
  }

  /* Flower 1: Pink & Yellow Plumeria (Top-right corner) */
  .flower1 {
    width: 125px;
    top: -24px;
    right: -28px;
    animation: floatFlower1 7s ease-in-out infinite;
  }

  /* Flower 2: Creamy Yellow Plumeria (Bottom-left side) */
  .flower2 {
    width: 105px;
    bottom: 30px;
    left: -36px;
    animation: floatFlower2 8s ease-in-out infinite 0.8s;
  }

  /* Flower 3: Soft Pink Plumeria (Upper-left curve) */
  .flower3 {
    width: 90px;
    top: 40px;
    left: -32px;
    animation: floatFlower3 6.5s ease-in-out infinite 0.4s;
  }

  /* Flower 4: Tropical Pink Hibiscus (Bottom-right corner) */
  .flower4 {
    width: 135px;
    bottom: -28px;
    right: -24px;
    animation: floatFlower4 7.5s ease-in-out infinite 1.2s;
  }

  @keyframes floatFlower1 {
    0%, 100% {
      transform: translateY(0) rotate(15deg);
    }
    50% {
      transform: translateY(-9px) rotate(19deg);
    }
  }

  @keyframes floatFlower2 {
    0%, 100% {
      transform: translateY(0) rotate(-18deg);
    }
    50% {
      transform: translateY(7px) rotate(-14deg);
    }
  }

  @keyframes floatFlower3 {
    0%, 100% {
      transform: translateY(0) rotate(-22deg);
    }
    50% {
      transform: translateY(-7px) rotate(-17deg);
    }
  }

  @keyframes floatFlower4 {
    0%, 100% {
      transform: translateY(0) rotate(12deg);
    }
    50% {
      transform: translateY(8px) rotate(16deg);
    }
  }

  /* ==========================================================================
     Projects Section
     ========================================================================== */
  .projects {
    background: #fff5f8;
    padding: 5.5rem 1.5rem;
    border-top: 1px solid rgba(219, 39, 119, 0.08);
    border-bottom: 1px solid rgba(219, 39, 119, 0.08);
  }

  .projects-inner {
    max-width: var(--container-max, 1040px);
    margin: 0 auto;
    width: 100%;
  }

  .section-eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--pink);
    margin-bottom: 0.5rem;
  }

  h2 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    margin: 0 0 0.75rem;
    color: var(--text);
  }

  .section-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 58ch;
    margin: 0;
  }

  .grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    margin-top: 2.75rem;
  }

  .card {
    background: var(--white);
    padding: 2.25rem;
    border-radius: 20px;
    border: 1px solid rgba(219, 39, 119, 0.12);
    box-shadow: 0 6px 25px rgba(219, 39, 119, 0.06);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--pink-light);
    box-shadow: 0 14px 35px rgba(219, 39, 119, 0.14);
  }

  .card-top {
    margin-bottom: 0.75rem;
  }

  .card-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--pink);
    background: var(--pink-tint);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    margin-bottom: 0.65rem;
  }

  .card h3 {
    margin: 0;
    font-size: 1.45rem;
    color: var(--text);
  }

  .card-desc {
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0.75rem 0 1.5rem;
    flex-grow: 1;
  }

  .tech {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech li {
    background: var(--yellow-tint);
    color: var(--yellow-text);
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-size: 0.825rem;
    font-weight: 600;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--pink);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .card-link:hover {
    color: var(--pink-hover);
    gap: 0.75rem;
  }

  /* ==========================================================================
     Contact Section
     ========================================================================== */
  .contact {
    background: var(--white);
    padding: 6rem 1.5rem;
  }

  .contact-inner {
    max-width: var(--container-max, 1040px);
    margin: 0 auto;
    width: 100%;
  }

  .contact-card {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
    background: linear-gradient(145deg, #ffffff 0%, var(--pink-tint) 100%);
    border: 1px solid var(--pink-border);
    border-radius: 28px;
    padding: 4rem 2.5rem;
    box-shadow: 0 16px 45px rgba(219, 39, 119, 0.08);
  }

  .contact-card h2 {
    margin-top: 0.25rem;
    margin-bottom: 1rem;
  }

  .contact-desc {
